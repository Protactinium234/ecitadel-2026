[Unit]
Description=SSH selective honeypot (port 22 — fakes weak pw, proxies real to backend sshd)
Documentation=https://github.com/ — see /usr/local/sbin/ssh-honeypot
After=network-online.target sshd.service ssh.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/ssh-honeypot
Restart=on-failure
RestartSec=5

# Run as root (needs CAP_NET_BIND_SERVICE for port 22) but otherwise sandbox.
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# NOTE: MemoryDenyWriteExecute=yes is incompatible with CPython's JIT/bytecode
# behaviour and crashes some paramiko backends. Leave it off.
ReadWritePaths=/var/log/ssh-honeypot /etc/ssh-honeypot
# We need read access to the real sshd host keys (to preserve fingerprint)
# and to every user's ~/.ssh/authorized_keys (for pubkey verification).
# ProtectHome=read-only allows the latter without giving write access.
ProtectHome=read-only
# /etc/ssh is already readable under ProtectSystem=strict (it doesn't write).

# Default config — override via /etc/default/ssh-honeypot or systemd drop-in.
Environment="HONEYPOT_PORT=22"
Environment="REAL_SSH_HOST=127.0.0.1"
Environment="REAL_SSH_PORT=2222"
Environment="WEAK_PASS_FILE=/etc/ssh-honeypot/weak-passwords.txt"
Environment="HOST_KEY_DIR=/etc/ssh"
Environment="FALLBACK_KEY_PATH=/etc/ssh-honeypot/host_rsa_key"
Environment="PROXY_KEY_PATH=/etc/ssh-honeypot/proxy_id_ed25519"
Environment="LOG_DIR=/var/log/ssh-honeypot"
EnvironmentFile=-/etc/default/ssh-honeypot

[Install]
WantedBy=multi-user.target
